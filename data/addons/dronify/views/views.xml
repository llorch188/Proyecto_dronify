<odoo>
  <data>
    <!-- VUELOS -->

    <record model="ir.ui.view" id="dronify.vuelos_list">
      <field name="name">Vuelos Dronify</field>
      <field name="model">dronify.vuelos</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="dron_id"/>
          <field name="piloto_id"/>
          <field name="peso_total"/>
          <field name="consumo_estimado" widget="percentage"/>
          <field name="preparado" widget="boolean_toggle"/>
          <field name="realizado" widget="boolean_toggle"/>
        </list>
      </field>
    </record>
<record model="ir.ui.view" id="dronify.vuelos_form">
  <field name="name">Vuelos Dronify Form</field>
  <field name="model">dronify.vuelos</field>
  <field name="arch" type="xml">

    <form>
      <header>

        <!-- Preparar -->
        <button name="action_preparar_vuelo"
                string="Preparar Vuelo"
                type="object"
                class="oe_highlight"
                invisible="preparado == True"/>

        <!-- Desbloquear -->
        <button name="action_desbloquear"
                string="Desbloquear"
                type="object"
                invisible="preparado == False"/>

        <!-- Finalizar -->
        <button name="action_finalizar_vuelo"
                string="Finalizar Vuelo"
                type="object"
                invisible="realizado == True"/>

      </header>

      <sheet>

        <!-- PLANIFICACION -->
        <group string="Planificación">

          <field name="name"
                 readonly="preparado == True"/>

          <field name="dron_id"
                 readonly="preparado == True"/>

          <field name="piloto_id"
                 readonly="preparado == True"/>

        </group>

        <!-- ESTADO -->
        <group string="Estado y Control">

          <field name="preparado" readonly="True"/>
          <field name="realizado" readonly="True"/>

        </group>

        <!-- NOTEBOOK -->
        <notebook>

          <!-- PAQUETES -->
          <page string="Paquetes">

            <field name="paquete_ids" readonly="preparado == True">
              <list editable="bottom">
                <field name="codigo"/>
                <field name="name"/>
                <field name="peso"/>
                <field name="cliente_id"/>
                <field name="dron_relacionado"/>
              </list>

            </field>

            <!-- Totales -->
            <group col="2">
              <field name="peso_total" readonly="1"/>
              <field name="consumo_estimado" widget="percentage" readonly="1"/>
            </group>

          </page>

        </notebook>

      </sheet>
    </form>

  </field>
</record>

    <record model="ir.actions.act_window" id="dronify.action_window_vuelos">
      <field name="name">Vuelos</field>
      <field name="res_model">dronify.vuelos</field>
      <field name="view_mode">list,form</field>
    </record>

<!-- DRONES -->
    <record model="ir.ui.view" id="dronify.drones_list">
      <field name="name">Drones Dronify</field>
      <field name="model">dronify.drones</field>
      <field name="arch" type="xml">
        <list decoration-danger="bateria &lt;= 10">
          <field name="name"/>
          <field name="capacidad_max"/>
          <field name="bateria" widget="progressbar"/>
          <field name="estado"
            widget="badge"
            decoration-success="estado == 'disponible'"
            decoration-warning="estado == 'vuelo'"
            decoration-danger="estado == 'taller'"/>
        </list>
      </field>
    </record>

    <record model="ir.actions.act_window" id="dronify.action_window_drones">
      <field name="name">Drones</field>
      <field name="res_model">dronify.drones</field>
      <field name="view_mode">list</field>
    </record>

<!-- PAQUETES -->
      <record model="ir.ui.view" id="dronify.paquetes_list">
      <field name="name">Paquetes Dronify</field>
      <field name="model">dronify.paquetes</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="peso"/>
          <field name="cliente_id"/>
          <field name="vuelo_id"/>
          <field name="dron_relacionado"/>
        </list>
      </field>
    </record>

    <record model="ir.actions.act_window" id="dronify.action_window_paquetes">
      <field name="name">Paquetes</field>
      <field name="res_model">dronify.paquetes</field>
      <field name="view_mode">list</field>
    </record>

<!-- CLIENTES -->

    <record model="ir.actions.act_window" id="action_window_clientes">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('es_cliente', '=', True)]</field>
    </record>

    <!-- FORMULARIO CLIENTES -->
    <record id="clientes_view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.clientes</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="mode">primary</field> 
        <field name="arch" type="xml">
        <xpath expr="//sheet/notebook/page[@name='internal_notes']" position="after">
              <page name="devs" string="Datos Cliente">
                  <group>
                      <group>
                          <field name="es_cliente"/>
                          <field name="es_piloto"/>
                          <field name="es_vip"/>
                      </group>
                  </group>
              </page>
          </xpath>
      </field> 
    </record>

    <record model="ir.actions.act_window.view" id="action_window_clientes_list">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="base.view_partner_tree"/>
        <field name="act_window_id" ref="action_window_clientes"/>
    </record>
    
    <record model="ir.actions.act_window.view" id="action_window_clientes_form">
      <field name="sequence" eval="2"></field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="base.view_partner_form"></field>
      <field name="act_window_id" ref="action_window_clientes"></field>
    </record>

<!-- PILOTOS -->

    <record model="ir.actions.act_window" id="action_window_pilotos">
        <field name="name">Pilotos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('es_piloto', '=', True)]</field>
    </record>

    <!-- FORMULARIO PILOTOS -->
    <record id="pilotos_view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.pilotos</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="mode">primary</field> 
        <field name="arch" type="xml">
        <xpath expr="//sheet/notebook/page[@name='internal_notes']" position="after">
              <page name="devs" string="Datos Piloto">
                  <group>
                      <group>
                          <field name="es_piloto"/>
                          <field name="licencia"/>
                          <field name="dron_autorizado_ids" widget="many2many_tags"/>
                          <field name="es_cliente" editable="True"/>                          
                          <field name="es_vip"
                                modifiers="{'invisible': [('es_cliente', '=', False)]}"
                                context="{
                                        'form_view_ref': 'pilotos_view_partner_form_inherit',
                                        'default_es_cliente': True
                                    }"
                          />
                      </group>
                  </group>
              </page>
          </xpath>
      </field> 
    </record>

    <record model="ir.actions.act_window.view" id="action_window_pilotos_list">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="base.view_partner_tree"/>
        <field name="act_window_id" ref="action_window_pilotos"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_window_pilotos_form">
      <field name="sequence" eval="2"></field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="base.view_partner_form"></field>
      <field name="act_window_id" ref="action_window_pilotos"></field>
    </record>

    <!-- MENU ROOT -->
    <menuitem name="Dronify" id="menu_dronify_root"/>

    <!-- SUBMENU Vuelos-->
    <menuitem name="Vuelos" id="menu_dronify_vuelos"
    parent="menu_dronify_root"
    action="dronify.action_window_vuelos"/>

        <!-- SUBMENU Drones-->
    <menuitem name="Drones" id="menu_dronify_drones"
    parent="menu_dronify_root"
    action="dronify.action_window_drones"/>

    <!-- SUBMENU Paquetes-->
    <menuitem name="Paquetes" id="menu_dronify_paquetes"
    parent="menu_dronify_root"
    action="dronify.action_window_paquetes"/>

    <!-- SUBMENU Clientes -->
    <menuitem name="Clientes" id="menu_dronify_clientes" 
    action="dronify.action_window_clientes"
    parent="menu_dronify_root" 
    sequence="50"/>

        <!-- SUBMENU Pilotos -->
    <menuitem name="Pilotos" id="menu_dronify_pilotos" 
    action="dronify.action_window_pilotos"
    parent="menu_dronify_root" 
    sequence="50"/>

  </data>
</odoo>
