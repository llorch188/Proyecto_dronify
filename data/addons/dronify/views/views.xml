<odoo>
  <data>
    <!-- VUELOS -->

    <record model="ir.ui.view" id="dronify.vuelos_list">
      <field name="name">Vuelos Dronify</field>
      <field name="model">dronify.vuelos</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="dron_id"/>
          <field name="piloto_id"/>
          <field name="zona_id"/>
          <field name="peso_total"/>
          <field name="consumo_texto" readonly="1"/>
          <field name="preparado" widget="boolean_toggle" readonly="1"/>
          <field name="realizado" widget="boolean_toggle" readonly="1"/>
        </list>
      </field>
    </record>
<record model="ir.ui.view" id="dronify.vuelos_form">
  <field name="name">Vuelos Dronify Form</field>
  <field name="model">dronify.vuelos</field>
  <field name="arch" type="xml">
    <form>
      <header>
        <button name="action_preparar_vuelo"
                string="Preparar Vuelo"
                type="object"
                class="oe_highlight"
                invisible="preparado == True"/>
        <button name="action_desbloquear"
                string="Desbloquear"
                type="object"
                invisible="preparado == False"/>
        <button name="action_finalizar_vuelo"
                string="Finalizar Vuelo"
                type="object"
                invisible="realizado == True"/>
      </header>

      <sheet>
        <!-- PARÁMETROS DE VUELO -->
        <group string="Zona del Vuelo">
          <field name="zona_id"/>
        </group>

        <!-- PLANIFICACIÓN -->
        <group string="Planificación">
          <field name="name" readonly="preparado == True"/>
          <field name="dron_id" readonly="preparado == True"/>
          <field name="piloto_id" readonly="preparado == True"/>
        </group>

        <!-- ESTADO -->
        <group string="Estado y Control">
          <field name="preparado" readonly="True"/>
          <field name="realizado" readonly="True"/>
        </group>

        <!-- NOTEBOOK -->
        <notebook>
          <page string="Paquetes">
            <field name="paquete_ids"
                  readonly="preparado == True"
                  domain="[('vuelo_id', '=', False)]">

                <list>
                    <field name="codigo"/>
                    <field name="name"/>
                    <field name="peso"/>
                    <field name="cliente_id"/>
                    <field name="dron_relacionado"/>
                </list>

            </field>
            <group col="2">
              <field name="peso_total" readonly="1"/>
              <field name="consumo_estimado" readonly="1"/>
            </group>
          </page>
        </notebook>
      </sheet>
    </form>
  </field>
</record>

    <record model="ir.actions.act_window" id="dronify.action_window_vuelos">
      <field name="name">Vuelos</field>
      <field name="res_model">dronify.vuelos</field>
      <field name="view_mode">list,form</field>
    </record>

<!-- ZONAS -->

<!-- ACCIÓN ZONAS -->
<record model="ir.actions.act_window" id="dronify.action_window_zonas">
    <field name="name">Zonas</field>
    <field name="res_model">dronify.zonas</field>
    <field name="view_mode">list,form</field>
</record>

<!-- VISTA LISTA -->
<record model="ir.ui.view" id="dronify.zonas_list">

    <field name="name">Zonas Dronify List</field>
    <field name="model">dronify.zonas</field>
    <field name="arch" type="xml">

        <list
            decoration-success="nivel_riesgo in ['1','2']"
            decoration-info="nivel_riesgo == '3'"
            decoration-warning="nivel_riesgo == '4'"
            decoration-danger="nivel_riesgo == '5'">

            <field name="name"/>
            <field name="distancia_km"/>
            <field name="nivel_riesgo"/>
            <field name="tarifa_base"/>
        </list>

    </field>
</record>

<!-- VISTA FORMULARIO -->
<record model="ir.ui.view" id="dronify.zonas_form">
    <field name="name">Zonas Dronify Form</field>
    <field name="model">dronify.zonas</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group string="Datos de la zona">
                    <field name="name"/>
                    <field name="distancia_km"/>
                    <field name="nivel_riesgo"/>
                    <field name="tarifa_base"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record model="ir.actions.act_window.view" id="action_window_zonas_list">
    <field name="sequence" eval="1"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="dronify.zonas_list"/>
    <field name="act_window_id" ref="dronify.action_window_zonas"/>
</record>

<record model="ir.actions.act_window.view" id="action_window_zonas_form">
    <field name="sequence" eval="2"/>
    <field name="view_mode">form</field>
    <field name="view_id" ref="dronify.zonas_form"/>
    <field name="act_window_id" ref="dronify.action_window_zonas"/>
</record>

<!-- DRONES -->
    
    <record model="ir.actions.act_window" id="dronify.action_window_drones">
      <field name="name">Drones</field>
      <field name="res_model">dronify.drones</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- LISTA DRONES -->
    <record model="ir.ui.view" id="dronify.drones_list">
      <field name="name">Drones Dronify</field>
      <field name="model">dronify.drones</field>
      <field name="arch" type="xml">
        <list decoration-danger="bateria &lt;= 10">
          <field name="name"/>
          <field name="capacidad_max"/>
          <field name="bateria" widget="progressbar"/>
          <field name="estado"
            widget="badge"
            decoration-success="estado == 'disponible'"
            decoration-warning="estado == 'vuelo'"
            decoration-danger="estado == 'taller'"/>
        </list>
      </field>
    </record>

    <!-- FORMULARIO DRONES -->
    <record model="ir.ui.view" id="dronify.drones_form">
        <field name="name">Drones Dronify Form</field>
        <field name="model">dronify.drones</field>
        
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group string="Datos del dron">
                        <field name="name"/>
                        <field name="capacidad_max"/>
                        <field name="bateria" widget="progressbar"/>
                        <field name="estado"/>
                    </group>

                    <notebook>
                        <page string="Pilotos autorizados">
                            <field name="piloto_autorizado_ids"
                                  widget="many2many_tags"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

<!-- PAQUETES -->
      <record model="ir.ui.view" id="dronify.paquetes_list">
      <field name="name">Paquetes Dronify</field>
      <field name="model">dronify.paquetes</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="peso"/>
          <field name="cliente_id"/>
          <field name="vuelo_id"/>
          <field name="dron_relacionado"/>
        </list>
      </field>
    </record>

    <record model="ir.actions.act_window" id="dronify.action_window_paquetes">
      <field name="name">Paquetes</field>
      <field name="res_model">dronify.paquetes</field>
      <field name="view_mode">list</field>
    </record>

<!-- CLIENTES -->

    <record model="ir.actions.act_window" id="action_window_clientes">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('es_cliente', '=', True)]</field>
        <field name="context">{ 'default_es_cliente': True,'desde_cliente': True}
    </field>
    </record>

<!-- FORMULARIO CLIENTES (herencia) -->
<record id="clientes_view_partner_form_inherit" model="ir.ui.view">
  <field name="name">res.partner.form.inherit.clientes</field>
  <field name="model">res.partner</field>
  <field name="inherit_id" ref="base.view_partner_form"/>
  <field name="mode">extension</field>
  <field name="arch" type="xml">
    <!-- ocultar pestaña internal_notes -->
    <xpath expr="//page[@name='internal_notes']" position="attributes">
      <attribute name="invisible">1</attribute>
    </xpath>

    <!-- ocultar pestañas/campos si existen (ajusta los names si tu vista base es diferente) -->
    <xpath expr="//page[@name='sales_purchases']" position="attributes">
      <attribute name="invisible">1</attribute>
    </xpath>
    <xpath expr="//page[@name='contact_addresses']" position="attributes">
      <attribute name="invisible">1</attribute>
    </xpath>
    <xpath expr="//field[@name='function']" position="attributes">
      <attribute name="invisible">1</attribute>
    </xpath>
    <xpath expr="//field[@name='website']" position="attributes">
      <attribute name="invisible">1</attribute>
    </xpath>

    <!-- insertar página Datos Cliente -->
    <xpath expr="//sheet/notebook" position="inside">
        <page name="client_data" string="Datos Cliente" invisible="not context.get('desde_cliente')">
            <group>
              <group>
                <field name="es_cliente" readonly="1"/>
                <field name="es_vip" invisible="not es_cliente"/>
                <field name="es_piloto"/>
                <field name="licencia" invisible="not es_piloto"/>
              </group>
            </group>
        </page>
    </xpath>
  </field>
</record>

    <record model="ir.actions.act_window.view" id="action_window_clientes_list">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="base.view_partner_tree"/>
        <field name="act_window_id" ref="action_window_clientes"/>
    </record>
    
    <record model="ir.actions.act_window.view" id="action_window_clientes_form">
      <field name="sequence" eval="2"></field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="base.view_partner_form"></field>
      <field name="act_window_id" ref="action_window_clientes"></field>
    </record>

<!-- PILOTOS -->
<record model="ir.actions.act_window" id="action_window_pilotos">
    <field name="name">Pilotos</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('es_piloto', '=', True)]</field>
    <field name="context">{'default_es_piloto': True,'desde_pilotos': True}</field>
</record>

<!-- FORMULARIO PILOTOS -->
<record id="pilotos_view_partner_form_inherit" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.pilotos</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="mode">extension</field>
    <field name="arch" type="xml">

        <!-- OCULTAR PESTAÑA "Internal Notes" -->
        <xpath expr="//page[@name='internal_notes']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

        <!-- ocultar campos individuales -->
        <xpath expr="//field[@name='function']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>

        <xpath expr="//page[@name='sales_purchases']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>

        <xpath expr="//page[@name='contact_addresses']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>

        <xpath expr="//field[@name='website']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>

        <!-- AGREGAR PÁGINA "Datos Piloto" -->
        <xpath expr="//sheet/notebook" position="inside">
            <page name="pilot_data" string="Datos Piloto" invisible="not context.get('desde_pilotos')">
                <group>
                    <group>
                        <field name="es_piloto" readonly="1"/>
                        <field name="licencia" required="es_piloto"/>
                        <field name="dron_autorizado_ids" widget="many2many_tags"/>
                        <field name="es_cliente"/>
                        <field name="es_vip" invisible="not es_cliente"/>
                    </group>
                </group>
            </page>
        </xpath>

    </field> 
</record>

<record model="ir.actions.act_window.view" id="action_window_pilotos_list">
    <field name="sequence" eval="1"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="base.view_partner_tree"/>
    <field name="act_window_id" ref="action_window_pilotos"/>
</record>

<record model="ir.actions.act_window.view" id="action_window_pilotos_form">
    <field name="sequence" eval="2"/>
    <field name="view_mode">form</field>
    <field name="view_id" ref="base.view_partner_form"/>
    <field name="act_window_id" ref="action_window_pilotos"/>
</record>

    <!-- MENU ROOT -->
    <menuitem name="Dronify" id="menu_dronify_root"/>

    <!-- SUBMENU Vuelos-->
    <menuitem name="Vuelos" id="menu_dronify_vuelos"
    parent="menu_dronify_root"
    action="dronify.action_window_vuelos"/>

    <!-- SUBMENU ZONAS -->
    <menuitem name="Zonas" id="menu_dronify_zonas"
    parent="menu_dronify_root"
    action="dronify.action_window_zonas"/>

    <!-- SUBMENU Drones-->
    <menuitem name="Drones" id="menu_dronify_drones"
    parent="menu_dronify_root"
    action="dronify.action_window_drones"/>

    <!-- SUBMENU Paquetes-->
    <menuitem name="Paquetes" id="menu_dronify_paquetes"
    parent="menu_dronify_root"
    action="dronify.action_window_paquetes"/>

    <!-- SUBMENU Clientes -->
    <menuitem name="Clientes" id="menu_dronify_clientes" 
    action="dronify.action_window_clientes"
    parent="menu_dronify_root" 
    sequence="50"/>

        <!-- SUBMENU Pilotos -->
    <menuitem name="Pilotos" id="menu_dronify_pilotos" 
    action="dronify.action_window_pilotos"
    parent="menu_dronify_root" 
    sequence="50"/>

  </data>
</odoo>